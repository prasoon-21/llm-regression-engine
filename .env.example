# ========================================================
# LLM CI/CD Regression & Red-Teaming Engine Environment Config
# ========================================================

# Service Ports & Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Redis Task Broker
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=llm_eval_jobs
RATE_LIMIT_PER_MINUTE=60

# GitHub App Configuration & Webhooks
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_BOT_NAME=llm-regression-bot[bot]

# LangSmith Tracing & Harvesting
LANGSMITH_API_KEY=lsv2_pt_example
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_DEFAULT_PROJECT=default

# LiteLLM Proxy / BYOK Gateway
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-proxy-master-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Persistent Storage (Postgres / Supabase)
DATABASE_URL=sqlite+aiosqlite:///./regression_engine.db
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/regression_engine

# Telemetry
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
